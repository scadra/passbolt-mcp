# Copy to .env.e2e (git-ignored), then run scripts/e2e.sh.
# The MCP user: an account of the server with the role user, without MFA.
PASSBOLT_MCP_E2E_SERVER_URL=https://passbolt.local
PASSBOLT_MCP_E2E_PRIVATE_KEY_FILE=mcp-agent.asc
PASSBOLT_MCP_E2E_PASSPHRASE_FILE=mcp-agent.passphrase
# Another user of the server, to share with.
PASSBOLT_MCP_E2E_SHARE_WITH=betty@passbolt.local
# Optional: the pinned server key; without it, the key the server sends now.
# PASSBOLT_MCP_E2E_SERVER_KEY_FILE=server-key.asc
# From a container where *.ddev.site resolves to itself: pin the name to the Docker host.
# PASSBOLT_MCP_E2E_RESOLVE=passbolt.ddev.site:443:172.17.0.1
# ddev serves a mkcert certificate this machine may not trust.
# PASSBOLT_MCP_E2E_TLS_SKIP_VERIFY=true
